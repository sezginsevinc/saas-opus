{
    "//": "agtech-saas/api/tsconfig.json",
    "compilerOptions": {
      "target": "ES2022",
      "module": "commonjs",
      "lib": ["ES2022"],
      "outDir": "./dist",
      "rootDir": "./src",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "moduleResolution": "node",
      "allowJs": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noImplicitReturns": true,
      "noFallthroughCasesInSwitch": true,
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
      "types": ["node", "jest"],
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"],
        "@config/*": ["src/config/*"],
        "@controllers/*": ["src/controllers/*"],
        "@models/*": ["src/models/*"],
        "@routes/*": ["src/routes/*"],
        "@services/*": ["src/services/*"],
        "@utils/*": ["src/utils/*"],
        "@middlewares/*": ["src/middlewares/*"],
        "@types/*": ["src/types/*"]
      }
    },
    "include": [
      "src/**/*"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "tests"
    ],
    "ts-node": {
      "require": ["tsconfig-paths/register"]
    }
  }