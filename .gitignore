 # agtech-saas/.gitignore

# Environment files
.env
.env.local
.env.production
.env.*.local

# Dependencies
node_modules/
venv/
__pycache__/
*.pyc
.Python

# Build outputs
dist/
build/
*.egg-info/
.cache/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
.coverage
.pytest_cache/
*.cover
htmlcov/

# Database
*.db
*.sqlite
*.sqlite3

# Docker volumes (local development)
postgres_data/
redis_data/
mongo_data/
influxdb_data/
rabbitmq_data/
ai_models/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# OS files
Thumbs.db
desktop.ini

# SSL certificates (except examples)
*.pem
*.key
*.crt
*.csr
!*.example.*

# Backup files
*.backup
*.bak

# Python specific
*.py[cod]
*$py.class
.env.python
pip-log.txt
pip-delete-this-directory.txt

# TypeScript
*.tsbuildinfo

# Next.js specific (if migrating later)
.next/
out/

# Uploads (user content)
uploads/
public/uploads/

# Prisma
prisma/migrations/dev/

# AI Model files (too large for git)
*.h5
*.pkl
*.model
*.weights
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
