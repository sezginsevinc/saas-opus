# agtech-saas/.env.example

# Application Environment
NODE_ENV=development

# PostgreSQL Configuration
POSTGRES_DB=agtech_db
POSTGRES_USER=agtech_user
POSTGRES_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here

# MongoDB Configuration
MONGO_USER=agtech_mongo
MONGO_PASSWORD=your_mongo_password_here

# InfluxDB Configuration
INFLUXDB_USER=agtech_influx
INFLUXDB_PASSWORD=your_influx_password_here
INFLUXDB_ORG=agtech
INFLUXDB_BUCKET=iot_data
INFLUXDB_TOKEN=your_influx_token_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# AI Service Configuration
AI_SERVICE_API_KEY=your_ai_service_api_key_here

# RabbitMQ Configuration
RABBITMQ_USER=agtech_rabbit
RABBITMQ_PASSWORD=your_rabbit_password_here

# External API Keys
OPENWEATHER_API_KEY=your_openweather_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
WHATSAPP_API_KEY=your_whatsapp_api_key

# Payment Gateway
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Application URLs (Production)
API_URL=https://api.agtech.com.tr
WEB_URL=https://app.agtech.com.tr
AI_SERVICE_URL=https://ai.agtech.com.tr

# Türkiye Specific APIs
MGM_API_KEY=your_mgm_api_key
TMO_API_KEY=your_tmo_api_key
TARIM_BAKANLIK_API_KEY=your_tarim_api_key